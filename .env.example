# Copy this file to .env and CHANGE EVERY VALUE before deploying.
# .env is gitignored - never commit real secrets.

# Flask JWT signing secret - generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# MySQL credentials created by the db container on first boot.
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PASSWORD=change-me-app-password

# Allowed frontend origins (comma-separated). With the nginx proxy the
# browser only ever talks to one origin, but keep this accurate anyway.
CORS_ORIGINS=http://localhost:5173

# Public port of the frontend container. Leave unset for plain http://IP.
# Set to 8080 only when adding HTTPS with a host-level nginx + certbot
# (docs/deploy.md Step 8).
# FRONTEND_PORT=8080
